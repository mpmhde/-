// Пространственная сложность: O(n)
Аналик: Рекурсивное деление массива пополам (log n уровней) и слияние за O(n) на каждом уровне.

  //Алгоритм сортировки Шелла (Shellsort)
      #include <iostream> // Подключаем стандартные средства ввода-вывода

// Вспомогательная функция для обмена двух элементов массива
void swap(int &a, int &b) {
    int temp = a;   // Временная переменная хранит первое число
    a = b;          // Первое число становится вторым
    b = temp;       // Второе число становится первым
}

// Основная функция сортировки Шелла
void shellSort(int arr[], int n) {
    // Выбор шагов интервала (обычно используют последовательность h = 3h + 1, далее уменьшаем шаг)
    for (int gap = n / 2; gap > 0; gap /= 2) { // Постепенно уменьшаем интервал
        // Проводим сортировку вставками для подгрупп с данным шагом
        for (int i = gap; i < n; i++) {
            int temp = arr[i]; // Ключ, который хотим правильно расположить
            
            // Смещение элементов группы дальше по мере необходимости
            int j = i;
            while (j >= gap && arr[j - gap] > temp) {
                arr[j] = arr[j - gap]; // Сдвиг большего элемента вперед
                j -= gap;              // Двигаемся к началу группы
            }
            
            // Расположение ключа в правильной позиции
            arr[j] = temp;
        }
    }
}

// Функция для отображения массива
void displayArray(const int arr[], int size) {
    std::cout << "Отсортированный массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';
    }
    std::cout << "\n";
}

// Главная функция программы
int main() {
    int array[] = {64, 34, 25, 12, 22, 11, 90}; // Тестовый массив
    int n = sizeof(array) / sizeof(array[0]);     // Определим размер массива
    
    std::cout << "Исходный массив: ";
    displayArray(array, n);                       // Выводим исходный массив
    
    shellSort(array, n);                          // Применяем сортировку Шелла
    
    std::cout << "Отсортированный массив: ";
    displayArray(array, n);                       // Выводим отсортированный массив
    
    return 0;                                     // Программа выполнена успешно
}

