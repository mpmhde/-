//Бинарный поиск (Binary Search)
#include <iostream> // Подключаем стандартную библиотеку ввода-вывода

// Бинарный поиск в отсортированном массиве
int binarySearch(int arr[], int start, int end, int target) {
    while (start <= end) {                       // Продолжаем поиск, пока диапазон не станет пустым
        int middle = start + (end - start) / 2;  // Находим средний элемент диапазона
        
        if (arr[middle] == target) {             // Если нашли искомый элемент
            return middle;                       // Возвращаем его индекс
        }
        
        if (arr[middle] < target) {              // Если целевой элемент больше среднего
            start = middle + 1;                  // Сокращаем диапазон поиска в правую сторону
        } else {                                 // Если целевой элемент меньше среднего
            end = middle - 1;                    // Сокращаем диапазон поиска в левую сторону
        }
    }
    
    return -1;                                  // Если элемент не найден, возвращаем -1
}

// Функция для отображения массива
void displayArray(const int arr[], int size) {
    std::cout << "Массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';
    }
    std::cout << "\n";
}

// Главная функция программы
int main() {
    int sortedArray[] = {11, 12, 22, 25, 34, 64, 90}; // Отсортированный массив
    int n = sizeof(sortedArray) / sizeof(sortedArray[0]); // Длина массива
    int target = 25;                                    // Цель поиска
    
    std::cout << "Искомый элемент: " << target << "\n";
    displayArray(sortedArray, n);                        // Выводим массив
    
    int result = binarySearch(sortedArray, 0, n - 1, target); // Выполняем поиск
    
    if (result != -1) {
        std::cout << "Элемент найден на позиции: " << result << "\n"; // Выводим результат
    } else {
        std::cout << "Элемент не найден.\n";
    }
    
    return 0;                                            // Завершаем программу
}

