//Интерполирующий поиск (Interpolating search)
#include <iostream> // Подключаем стандартную библиотеку ввода-вывода

// Функция интерполирующего поиска
int interpolationSearch(int arr[], int size, int target) {
    int low = 0;           // Нижняя граница поиска
    int high = size - 1;   // Верхняя граница поиска
    
    while ((low <= high) && (target >= arr[low]) && (target <= arr[high])) {
        // Если массив содержит одинаковый элемент, возвращаем первую позицию
        if (arr[low] == arr[high])
            return (target == arr[low]) ? low : -1;
        
        // Оценка позиции искомого элемента
        int pos = low + (((double)(high - low) /
                          (arr[high] - arr[low])) *
                         (target - arr[low]));
        
        // Проверка найденного элемента
        if (arr[pos] == target) {
            return pos;     // Найден элемент, возвращаем его индекс
        }
        
        // Изменяем границы поиска в зависимости от положения найденного элемента
        if (arr[pos] < target) {
            low = pos + 1;  // Если элемент меньше цели, смотрим правее
        } else {
            high = pos - 1; // Если элемент больше цели, смотрим левее
        }
    }
    
    return -1;             // Если элемент не найден, возвращаем -1
}

// Функция для отображения массива
void displayArray(const int arr[], int size) {
    std::cout << "Массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';
    }
    std::cout << "\n";
}

// Главная функция программы
int main() {
    int sortedArray[] = {11, 12, 22, 25, 34, 64, 90}; // Уже отсортированный массив
    int n = sizeof(sortedArray) / sizeof(sortedArray[0]); // Длина массива
    int target = 25;                                    // Цель поиска
    
    std::cout << "Искомый элемент: " << target << "\n";
    displayArray(sortedArray, n);                        // Выводим массив
    
    int result = interpolationSearch(sortedArray, n, target); // Выполняем поиск
    
    if (result != -1) {
        std::cout << "Элемент найден на позиции: " << result << "\n"; // Выводим результат
