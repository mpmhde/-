 Временная сложность: O(n²) в среднем и худшем случае, O(n) в лучшем (уже отсортирован)
Анализ: В худшем случае два вложенных цикла по n итераций. С оптимизацией swapped в лучшем случае (отсортированный массив) - один проход.

  //Алгоритм сортировки вставками («Insertion Sort»)
  #include <iostream> // Подключаем стандартную библиотеку ввода-вывода

// Процедура сортировки вставками
void insertionSort(int arr[], int n) {
    for (int i = 1; i < n; ++i) {                     // Начинаем с второго элемента (индекс 1)
        int key = arr[i];                             // Текущий элемент, который будем вставлять в отсортированную часть
        int j = i - 1;                                // Индекс предыдущего элемента в отсортированном участке
        
        // Перемещаемся назад по отсортированной части массива, сдвигая большие элементы вправо
        while (j >= 0 && arr[j] > key) {              // Пока не достигли начала и предыдущий элемент больше текущего
            arr[j + 1] = arr[j];                      // Сдвигаем больший элемент на одну позицию вперед
            --j;                                      // Переходим к следующему меньшему элементу слева
        }
        
        arr[j + 1] = key;                             // Вставляем наш ключ в правильную позицию
    }
}

// Функция для отображения массива
void showArray(const int arr[], int size) {
    std::cout << "Отсортированный массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';
    }
    std::cout << "\n";
}

// Основная точка входа в программу
int main() {
    int array[] = {64, 34, 25, 12, 22, 11, 90};      // Исходный массив
    int n = sizeof(array) / sizeof(array[0]);         // Получаем длину массива
    
    std::cout << "Исходный массив: ";
    showArray(array, n);                              // Выводим исходный массив
    
    insertionSort(array, n);                          // Применяем сортировку вставками
    
    std::cout << "Отсортированный массив: ";
    showArray(array, n);                              // Выводим отсортированный массив
    
    return 0;                                        // Завершение программы
}

