//Алгоритм сортировки выбором (Selection Sort)
#include <iostream> // Подключаем библиотеку ввода-вывода

// Функция swap меняет местами два значения a и b
void swap(int &a, int &b) {
    int temp = a;   // Создаем временную переменную для хранения значения первого аргумента
    a = b;          // Присваиваем первому элементу значение второго
    b = temp;       // Присваиваем второму элементу значение временного хранилища
}

// Основная функция SelectionSort сортирует массив методом выбора
void selectionSort(int arr[], int n) {    
    for (int i = 0; i < n - 1; ++i) {           // Проходим по каждому элементу массива кроме последнего
        int minIndex = i;                       // Предполагаем, что минимальный элемент находится на текущей позиции
        
        // Ищем минимальное значение среди оставшихся неотсортированных элементов
        for (int j = i + 1; j < n; ++j) {       
            if (arr[j] < arr[minIndex]) {      // Если найден элемент меньше текущего минимума,
                minIndex = j;                  // обновляем индекс минимального элемента
            }
        }
        
        // Меняем местами найденный минимум с элементом на текущей позиции
        if (minIndex != i) {                   // Проверяем, изменилось ли положение минимального элемента
            swap(arr[i], arr[minIndex]);       // Используем вспомогательную функцию swap для перестановки значений
        }
    }
}

// Вспомогательная функция для вывода содержимого массива
void printArray(const int arr[], int size) {
    std::cout << "Отсортированный массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';
    }
    std::cout << '\n';
}

// Главная функция программы
