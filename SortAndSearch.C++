    const int SIZE = 8;                        // Определяем размер массива
    int array[] = {64, 25, 12, 22, 11, 90, 3, 7}; // Пример исходного несортированного массива
    
    std::cout << "Исходный массив: ";
    printArray(array, SIZE);                    // Выводим содержимое исходного массива
    
    selectionSort(array, SIZE);                 // Сортируем массив методом выбора
  
    printArray(array, SIZE);Алгоритм сортировки выбором (Selection Sort) является простым алгоритмом сортировки, основанным на поиске минимального элемента среди оставшихся элементов массива и перемещением его в начало отсортированной части массива.

