Временная сложность: O(n²) в худшем случае, O(n log n) в лучшем
Анализ: Зависит от выбора последовательности шагов. В данном коде используется последовательность n/2, n/4...

//Быстрая сортировка (Quicksort)
#include <iostream> // Включаем стандартную библиотеку ввода-вывода

// Вспомогательная функция для обмена двух элементов массива
void swap(int &a, int &b) {
    int temp = a;   // Создаем временную переменную для сохранения значения
    a = b;          // Меняем значения местами
    b = temp;
}

// Быстрая сортировка (рекурсивная функция)
void quickSort(int arr[], int low, int high) {
    if (low < high) {                   // Базовое условие выхода из рекурсии
        int pi = partition(arr, low, high); // Выбираем точку разделения
        
        // Рекурсивно сортируем две полученные части
        quickSort(arr, low, pi - 1);    // Левая часть
        quickSort(arr, pi + 1, high);   // Правая часть
    }
}

// Функция разделения массива (Partitioning)
int partition(int arr[], int low, int high) {
    int pivot = arr[high];              // Последний элемент выбирается в качестве опорного
    int i = (low - 1);                  // Инициализация индекса малого элемента
    
    // Перебор элементов от low до high-1
    for (int j = low; j <= high - 1; j++) {
        if (arr[j] < pivot) {           // Если текущий элемент меньше опорного
            i++;                        // Увеличим индекс маленького элемента
            swap(arr[i], arr[j]);       // Поменяем местами элементы
        }
    }
    
    // Поместим опорный элемент на своё место
    swap(arr[i + 1], arr[high]);
    return (i + 1);                     // Возвращаем новую позицию опорного элемента
}

// Функция для отображения массива
void displayArray(const int arr[], int size) {
    std::cout << "Отсортированный массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';
    }
    std::cout << "\n";
}

// Главная функция программы
int main() {
    int array[] = {64, 34, 25, 12, 22, 11, 90}; // Исходный массив
    int n = sizeof(array) / sizeof(array[0]);     // Определяем размер массива
    
    std::cout << "Исходный массив: ";
    displayArray(array, n);                       // Выводим исходный массив
    
    quickSort(array, 0, n - 1);                   // Применяем быструю сортировку
    
    std::cout << "Отсортированный массив: ";
    displayArray(array, n);                       // Выводим отсортированный массив
    
    return 0;                                     // Успешное завершение программы
}

