Анализ: Построение кучи O(n) + n извлечений максимума по O(log n).

//Последовательный поиск (линейный поиск) 
#include <iostream> // Подключаем стандартную библиотеку ввода-вывода

// Функция для выполнения последовательного поиска
int sequentialSearch(int arr[], int size, int target) {
    for (int i = 0; i < size; ++i) {              // Перебираем все элементы массива
        if (arr[i] == target) {                   // Если нашли целевой элемент
            return i;                             // Возвращаем индекс элемента
        }
    }
    return -1;                                    // Если элемент не найден, возвращаем -1
}

// Функция для отображения массива
void displayArray(const int arr[], int size) {
    std::cout << "Массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';
    }
    std::cout << "\n";
}

// Главная функция программы
int main() {
    int array[] = {64, 34, 25, 12, 22, 11, 90}; // Исходный массив
    int n = sizeof(array) / sizeof(array[0]);     // Рассчитываем размер массива
    int target = 25;                             // Целевой элемент для поиска
    
    std::cout << "Искомый элемент: " << target << "\n";
    displayArray(array, n);                       // Выводим исходный массив
    
    int result = sequentialSearch(array, n, target); // Выполняем поиск
    
    if (result != -1) {
        std::cout << "Элемент найден на позиции: " << result << "\n"; // Выводим результат
    } else {
        std::cout << "Элемент не найден.\n";
    }
    
    return 0;                                     // Завершаем программу
}

