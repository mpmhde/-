//Алгоритм поиска Фибоначчи (Fibonacci Search)
#include <iostream> // Подключаем стандартную библиотеку ввода-вывода

// Функция для вычисления чисел Фибоначчи
int fibonacciNumber(int k) {
    if (k <= 1) return k;            // Первые два числа Фибоначчи (F_0=0, F_1=1)
    return fibonacciNumber(k - 1) + fibonacciNumber(k - 2); // Рекурсивное вычисление
}

// Функция поиска Фибоначчи
int fibonacciSearch(int arr[], int size, int target) {
    int offset = -1;                 // Смещение, которое будет использоваться позже
    int f1 = 0;                      // Число Фибоначчи F_(m-1)
    int f2 = 1;                      // Число Фибоначчи F_m
    int fm = f1 + f2;                // Следующее число Фибоначчи F_(m+1)
    
    // Ищем наименьшее число Фибоначчи, большее или равное размеру массива
    while (fm < size) {
          f1 = f2;                     // Перекладываем предыдущее число Фибоначчи
    f2 = fm;                     // Текущее число становится предыдущим
    fm = f1 + f2;                // Вычисляем следующее число Фибоначчи
}

// Основной цикл поиска
while (f2 > 1) {
    int index = std::min(offset + f1, size - 1); // Вычисляем возможную позицию
    
    if (arr[index] < target) {   // Если элемент меньше цели, двигаемся вправо
        f2 = f1;                // Обновляем числа Фибоначчи
        f1 = f1 - f2;           // Новый номер F(m-1)
        fm = f2;                 // Новый номер F(m)
        offset = index;          // Обновляем смещение
    } else if (arr[index] > target) { // Если элемент больше цели, двигаемся влево
        f2 = f1;                // Обновляем числа Фибоначчи
        f1 = f2 - f1;           // Новый номер F(m-1)
        fm = f2;                 // Новый номер F(m)
    } else {                     // Если элемент совпал с целью
        return index;            // Возвращаем позицию элемента
    }
}

// Дополнительная проверка последнего возможного кандидата
if (f1 && arr[offset + 1] == target) {
    return offset + 1;
}

return -1;                      // Если элемент не найден, возвращаем -1
  std::cout << "Искомый элемент: " << target << "\n";
displayArray(sortedArray, n);                        // Выводим массив

int result = fibonacciSearch(sortedArray, n, target); // Выполняем поиск

if (result != -1) {
    std::cout << "Элемент найден на позиции: " << result << "\n"; // Выводим результат
} else {
    std::cout << "Элемент не найден.\n";
}

return 0;                                           // Завершаем программу

