Временная сложность: O(n²) в среднем и худшем случае, O(n) в лучшем
Анализ: В худшем случае (обратно отсортированный) каждый элемент сдвигается к началу. В лучшем (отсортированный) - только внешний цикл.

  //Алгоритм сортировки слиянием (Merge Sort)
  #include <iostream> // Подключаем библиотеку для ввода-вывода

// Рекурсивная функция для сортировки массива методом слияния
void mergeSort(int arr[], int left, int right);

// Вспомогательная функция для объединения двух отсортированных частей массива
void merge(int arr[], int left, int mid, int right);

// Функция для демонстрации результата сортировки
void displayArray(const int arr[], int size);

// Основная функция сортировки слиянием
void mergeSort(int arr[], int left, int right) {
    if (left < right) {                                    // Проверяем условие продолжения деления массива
        int mid = left + (right - left) / 2;               // Определяем середину массива
        
        // Разделяем массив на две равные части и рекурсивно сортируем каждую половину
        mergeSort(arr, left, mid);                         // Левая половина
        mergeSort(arr, mid + 1, right);                    // Правая половина
        
        // Объединяем отсортированные половинки
        merge(arr, left, mid, right);                      // Вызываем процедуру слияния
    }
}

// Функция объединения двух отсортированных частей массива
void merge(int arr[], int left, int mid, int right) {
    int n1 = mid - left + 1;                               // Количество элементов в левой половине
    int n2 = right - mid;                                  // Количество элементов в правой половине
    
    // Временные массивы для левого и правого фрагментов
    int L[n1], R[n2];
    
    // Копируем элементы из основного массива в временные массивы
    for (int i = 0; i < n1; ++i)                           // Копирование левой половины
        L[i] = arr[left + i];
    for (int j = 0; j < n2; ++j)                           // Копирование правой половины
        R[j] = arr[mid + 1 + j];
    
    // Индексы временных массивов и общего массива
    int i = 0, j = 0, k = left;
    
    // Процесс слияния двух отсортированных массивов
    while (i < n1 && j < n2) {                             // Пока оба массива не закончились
        if (L[i] <= R[j])                                   // Если элемент из левой части меньше или равен элементу из правой
            arr[k++] = L[i++];                              // Добавляем элемент из левой части
        else
            arr[k++] = R[j++];                              // Иначе добавляем элемент из правой части
    }
    
    // Оставшиеся элементы одной из частей (если такая ситуация возникла)
    while (i < n1)                                          // Если остались элементы в левой части
        arr[k++] = L[i++];
    while (j < n2)                                          // Если остались элементы в правой части
        arr[k++] = R[j++];
}

// Функция для отображения содержимого массива
void displayArray(const int arr[], int size) {
    std::cout << "Отсортированный массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';
    }
    std::cout << "\n";
}

// Главная функция программы
int main() {
    int array[] = {64, 34, 25, 12, 22, 11, 90};           // Наш тестовый массив
    int n = sizeof(array) / sizeof(array[0]);               // Вычисление длины массива
    
    std::cout << "Исходный массив: ";
    displayArray(array, n);                                 // Выводим исходный массив
    
    mergeSort(array, 0, n - 1);                            // Вызываем процедуру сортировки
    
    std::cout << "Отсортированный массив: ";
    displayArray(array, n);                                 // Выводим отсортированный массив
    
    return 0;                                              // Завершаем программу
}

