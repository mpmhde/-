Временная сложность: O(n²) в лучшем, среднем и худшем случае
Анализ: Два вложенных цикла. Внешний проходит n-1 раз, внутренний - (n-1), (n-2), ..., 1 раз.
Сумма: (n-1) + (n-2) + ... + 1 = n(n-1)/2 → O(n²)

      //Алгоритм сортировки обменом 
      #include <iostream> // Библиотека для операций ввода-вывода

// Обменивает два числа путем передачи ссылок
void swap(int &a, int &b) {
    int temp = a;     // Сохранение текущего значения первого элемента
    a = b;            // Перенос значения второго элемента в первый
    b = temp;         // Установка старого значения первого элемента во второй
}

// Реализация алгоритма пузырьковой сортировки
void bubbleSort(int arr[], int n) {
    bool swapped;     // Флаг, сигнализирующий были ли изменения на данном проходе
    
    // Выполняем проходы пока не пройдем весь массив
    for (int i = 0; i < n - 1; ++i) {
        swapped = false;              // Сбрасываем флаг изменений
        
        // Проходим по оставшимся элементам массива
        for (int j = 0; j < n - i - 1; ++j) {
            // Если текущий элемент больше следующего, меняем их местами
            if (arr[j] > arr[j + 1]) {
                swap(arr[j], arr[j + 1]);
                swapped = true;       // Устанавливаем флаг, показывающий, что была замена
            }
        }
        
        // Если ни одна пара не поменялась местами, значит массив уже отсортирован
        if (!swapped) break;          // Выходим досрочно из внешнего цикла
    }
}

// Функция для отображения содержимого массива
void displayArray(const int arr[], int size) {
    std::cout << "Отсортированный массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';   // Печать элементов массива
    }
    std::cout << "\n";
}

// Точка входа в программу
int main() {
    int array[] = {64, 34, 25, 12, 22, 11, 90};
    int n = sizeof(array)/sizeof(array[0]); // Определение размера массива
    
    std::cout << "Исходный массив: ";
    displayArray(array, n);               // Показываем начальное состояние массива
    
    bubbleSort(array, n);                 // Запускаем процедуру сортировки
    
    std::cout << "Отсортированный массив: ";
    displayArray(array, n);               // Отображаем итоговую отсортированную последовательность
    
    return 0;                            // Успешное завершение программы
}

