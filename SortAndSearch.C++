 Временная сложность: O(n log n) в среднем, O(n²) в худшем случае
Анализ: В среднем хорошее разбиение, в худшем (уже отсортированный массив) разбиение 1:(n-1).

//Пирамидальная сортировка (Heapsort)
#include <iostream> // Подключаем стандартные средства ввода-вывода

// Функция преобразования массива в кучу (max heapify)
void heapify(int arr[], int n, int root) {
    int largest = root;       // Предположительно наибольший элемент - корень
    int leftChild = 2 * root + 1; // Левый дочерний узел
    int rightChild = 2 * root + 2; // Правый дочерний узел
    
    // Если левый ребенок существует и больше корня
    if (leftChild < n && arr[leftChild] > arr[largest])
        largest = leftChild;
    
    // Если правый ребенок существует и больше наибольшего на данный момент
    if (rightChild < n && arr[rightChild] > arr[largest])
        largest = rightChild;
    
    // Если наибольшее значение не в корне, меняем местами и продолжаем перестроение
    if (largest != root) {
        std::swap(arr[root], arr[largest]); // Меняем местами элементы
        heapify(arr, n, largest);           // Рекурсивно переупорядочиваем подчинённую ветвь
    }
}

// Основная функция пирамидальной сортировки
void heapSort(int arr[], int n) {
    // Формируем max-кучу из массива
    for (int i = n / 2 - 1; i >= 0; i--)
        heapify(arr, n, i);                 // Преобразование в кучу с уровня снизу вверх
    
    // Извлекаем максимальный элемент из кучи и повторно формируем её
    for (int i = n - 1; i > 0; i--) {
        std::swap(arr[0], arr[i]);          // Помещаем максимум в конец массива
        heapify(arr, i, 0);                 // Восстанавливаем структуру кучи
    }
}

// Функция для отображения массива
void displayArray(const int arr[], int size) {
    std::cout << "Отсортированный массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << arr[i] << ' ';
    }
    std::cout << "\n";
}

// Главная функция программы
int main() {
    int array[] = {64, 34, 25, 12, 22, 11, 90}; // Исходный массив
    int n = sizeof(array) / sizeof(array[0]);     // Определяем размер массива
    
    std::cout << "Исходный массив: ";
    displayArray(array, n);                       // Выводим исходный массив
    
    heapSort(array, n);                           // Применяем пирамидальную сортировку
    
    std::cout << "Отсортированный массив: ";
    displayArray(array, n);                       // Выводим отсортированный массив
    
    return 0;                                     // Успешное завершение программы
}

